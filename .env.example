# Copy to .env.local for local development, and add the same keys in your host's
# environment settings (Vercel / Netlify / Cloudflare).

# Public site URL (used for SEO, sitemap and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, never expose it to the browser or commit it
SUPABASE_SECRET_KEY=

# Enquiry email alerts (Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ENQUIRY_NOTIFY_TO=unitedestates.ncr@gmail.com,aayusharyan1210@gmail.com

# Shared secret for the daily keep-alive job
CRON_SECRET=
